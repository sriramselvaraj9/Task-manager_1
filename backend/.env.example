POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_database
DATABASE_URL=postgresql://your_username:your_password@db:5432/your_database

# AI key options:
# Use GROQ_API_KEY if you want to connect to Groq.
# Use OPENAI_API_KEY if you want to connect to OpenAI.
# Only one key is required.
# If GROQ_API_KEY is set and begins with gsk_, the app uses Groq.
# If OPENAI_API_KEY is set, the app uses OpenAI.
# Example:
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...

# Required for AI assistant. Set one of these keys:
# OPENAI_API_KEY=your_openai_api_key
# GROQ_API_KEY=your_groq_api_key